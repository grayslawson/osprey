<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>osprey</id><version>0.9.0b1</version><title>Osprey</title>
    <authors>Osprey contributors</authors>
    <licenseUrl>https://github.com/grayslawson/osprey/blob/main/LICENSE</licenseUrl>
    <projectUrl>https://github.com/grayslawson/osprey</projectUrl>
    <description>Ubiquiti PTZ controller for an existing Frigate installation. Requires Docker or Podman.</description>
    <tags>ptz camera frigate onvif rtsp</tags>
  </metadata>
  <files>
    <file src="..\..\compose.release.yaml" target="tools" />
    <file src="tools\chocolateyInstall.ps1" target="tools" />
    <file src="tools\chocolateyUninstall.ps1" target="tools" />
  </files>
</package>
