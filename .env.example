# Release deployment settings for compose.release.yaml / compose.release-bridge.yaml.
# Copy to .env and replace the documentation-only example values. Keep camera
# credentials and private addresses in a deployment secret store; never commit
# them here.
OSPREY_IMAGE=ghcr.io/grayslawson/osprey:v0.1.0
# This host's LAN address as reached by the camera (required).
OSPREY_HOST=192.0.2.10
# Bridge mode only: the host LAN address the published ports bind to.
# OSPREY_BIND=192.0.2.10
# Set to 1 for the first start to open the browser setup wizard.
# OSPREY_SETUP=1
