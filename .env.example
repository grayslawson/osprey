# Optional overrides for compose.release.yaml / compose.release-bridge.yaml.
# Nothing here is required: copy to .env only to change a default. Keep camera
# credentials and private addresses in a deployment secret store; never commit
# them here.
# Image to run instead of the release the Compose file came from.
# OSPREY_IMAGE=ghcr.io/grayslawson/osprey:0.9.0b6
# This host's LAN address as reached by the camera. Default: detected, and
# confirmed in the setup wizard.
# OSPREY_HOST=192.0.2.10
# Bridge mode only (required there): the host LAN address the ports bind to.
# OSPREY_BIND=192.0.2.10
# Empty opens the setup wizard on first run; 1 forces it open, 0 never opens it.
# OSPREY_SETUP=
