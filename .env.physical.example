# Copy to .env.physical and verify every value before physical handoff.
# Non-secret addressing only; never put camera or Protect credentials here.
#
# OSPREY_HOST is the address the camera is told to talk to. OSPREY_BIND is the
# local address the physical ports bind to:
# the LAN address on a native Linux host, or 127.0.0.1 when the Windows relay
# fronts them. Never 0.0.0.0.
# Documentation-only examples. Replace every value with your own trusted LAN
# addresses and camera MAC before running the physical preflight.
OSPREY_HOST=192.0.2.10
OSPREY_BIND=192.0.2.10
OSPREY_CAMERA_IP=192.0.2.20
OSPREY_CAMERA_MAC=001122334455
